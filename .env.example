# ChocoAI harness: every variable. Copy to .env (never commit .env). docs/deploy.md has the meaning of each.

# model backend
BASE_URL=http://localhost:1235/v1
API_KEY=lm-studio
MODEL=qwen/qwen3.6-35b-a3b

# admin access: /task (scripts) and /manage/* (dashboard through the node agent); unset = that endpoint does not exist
HARNESS_TOKEN=
HARNESS_ADMIN_TOKEN=

# sign-in with the Choco SSO (client "ai"); unset = everybody is a visitor
# AUTH_SECRET: openssl rand -hex 32
AUTH_SECRET=
SSO_ISSUER=https://account.chocorot.net
SSO_CLIENT_ID=ai
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://ai.chocorot.net/api/auth/sso/callback
HARNESS_PUBLIC_URL=https://ai.chocorot.net

# web search container (docker-compose.yml)
SEARXNG_SECRET=

# leave unset unless you accept an unconfined shell for users with the SSO role "shell"
# HARNESS_SHELL=unconfined
